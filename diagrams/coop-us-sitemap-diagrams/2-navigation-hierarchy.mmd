    MYPROFILE --> PROFILE_PAGE["/profile"]

    classDef primaryStyle fill:#bbdefb,stroke:#1976d2,stroke-width:2px
    classDef economyStyle fill:#fff9c4,stroke:#f9a825,stroke-width:2px
    classDef agentsStyle fill:#c8e6c9,stroke:#388e3c,stroke-width:2px
    classDef govStyle fill:#d1c4e9,stroke:#512da8,stroke-width:2px
    classDef overflowStyle fill:#e0e0e0,stroke:#616161,stroke-width:2px

    class PRIMARY,HOME,EXPLORE,COORDINATE,TREE,DASHBOARD,NETWORK,MYPROFILE primaryStyle
    class ECONOMY,ECONOMY_CLOUD,ECONOMY_PRICING,ECONOMY_PATRONAGE,ECONOMY_VENTURES,ECONOMY_STANDING economyStyle
    class AGENTS,AGENTS_PROFILES,AGENTS_LEADERBOARD,AGENTS_ECONOMIC,AGENTS_STANDING,AGENTS_CONSENT agentsStyle
    class GOVERNANCE,GOV_CALENDAR,GOV_HUBS,GOV_MOONS,GOV_PROPOSE,GOV_QUEUE,GOV_ADMIN govStyle
    class OVERFLOW,OVERFLOW_LEARN,OVERFLOW_ROADMAP,OVERFLOW_ABOUT,OVERFLOW_GRAPH,OVERFLOW_REPLAY,OVERFLOW_APPLY,OVERFLOW_SIGNOUT overflowStyle

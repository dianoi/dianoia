    ROOT --> PRIMARY
    ROOT --> ECONOMY
    ROOT --> AGENTS
    ROOT --> GOVERNANCE
    ROOT --> OVERFLOW

    HOME --> EXPLORE_PAGE["/explore"]
    EXPLORE --> DIMENSIONS_PAGE["/dimensions"]
    COORDINATE --> WORKSHOP["/coordinate"]
    TREE --> CHAIN_PAGE["/chain"]
    DASHBOARD --> DASH_PAGE["/dashboard"]
